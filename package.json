{
  "name": "compress-image",
  "displayName": "Compress Image",
  "description": "Lossless image compression + simple resizing in VS Code and Cursor.",
  "version": "0.1.0",
  "publisher": "serbytedevelopment",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Serbyte-Development/compress-image.git"
  },
  "homepage": "https://github.com/Serbyte-Development/compress-image#readme",
  "bugs": {
    "url": "https://github.com/Serbyte-Development/compress-image/issues"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "image compression",
    "image compressor",
    "image optimizer",
    "lossless compression",
    "lossless image compression",
    "compress image",
    "optimize image",
    "image optimization",
    "resize image",
    "image resize",
    "click to resize image",
    "resize image",
    "click to compress",
    "jpg",
    "jpeg optimizer",
    "mozjpeg",
    "webp",
    "webp optimizer",
    "gif",
    "gif optimizer",
    "avif",
    "avif optimizer",
    "oxipng",
    "gifsicle",
    "frontend",
    "web performance",
    "assets",
    "asset optimization",
    "local",
    "offline",
    "cursor"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Compress Image requires filesystem access and bundled native image optimizers."
    },
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "compressImage.compressImage",
        "title": "Compress",
        "category": "Compress Image"
      },
      {
        "command": "compressImage.resize256",
        "title": "Resize - 256px",
        "category": "Compress Image"
      },
      {
        "command": "compressImage.resize512",
        "title": "Resize - 512px",
        "category": "Compress Image"
      },
      {
        "command": "compressImage.resize1080",
        "title": "Resize - 1080px",
        "category": "Compress Image"
      }
    ],
    "submenus": [
      {
        "id": "compressImage.menu",
        "label": "Compress Image"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "compressImage.menu",
          "when": "resourceScheme == file && resourceExtname =~ /\\.(png|apng|jpe?g|webp|gif|avif)$/i",
          "group": "7_modification"
        }
      ],
      "compressImage.menu": [
        {
          "command": "compressImage.compressImage",
          "group": "1_compress"
        },
        {
          "command": "compressImage.resize256",
          "group": "2_resize@1"
        },
        {
          "command": "compressImage.resize512",
          "group": "2_resize@2"
        },
        {
          "command": "compressImage.resize1080",
          "group": "2_resize@3"
        }
      ],
      "commandPalette": [
        {
          "command": "compressImage.resize256",
          "when": "false"
        },
        {
          "command": "compressImage.resize512",
          "when": "false"
        },
        {
          "command": "compressImage.resize1080",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "postinstall": "node scripts/fetch-oxipng.mjs && node scripts/build-mozjpeg.mjs && node scripts/fetch-libwebp.mjs && node scripts/copy-tool-binaries.mjs && node scripts/fetch-gifsicle-source.mjs && node scripts/copy-runtime-licenses.mjs",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:runtime": "npm audit --omit=dev",
    "bundle:check": "node scripts/check-bundle-load.cjs",
    "check": "npm run typecheck && npm test && npm run format:check && npm run build && npm run bundle:check",
    "vscode:prepublish": "npm run build",
    "package:vsix": "npm run check && npm run audit:runtime && node scripts/package-vsix.mjs"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@343dev/gifsicle": "^1.2.0",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.96.0",
    "@upng/upng-js": "^2.2.2",
    "@vscode/vsce": "^3.9.2",
    "cmake-runtime": "^4.3.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "yauzl": "^3.2.0"
  }
}
